{include "header", ["title" => "Change password"]}

{if isset($model["error"])}
    <div class="flash flash-error">{$model["error"]}</div>
{/if}
{if isset($model["success"]) && $model["success"]}
    <div class="flash flash-success">Password has been changed successfully, you can <a href="{route 'auth.login'}">sign in</a>.</div>
{elseif isset($model["token"])}
    <form action="{route 'auth.password.reset.ticket', ['token' => $model['token']]}" method="post" class="form">
        {csrf}
        <label>Login</label>
        <input type="text" readonly value="{$model['user']->login}"/>
        <label for="password">New password</label>
        <input type="password" id="password" name="password" required/>
        <label for="confirm_password">Confirm new password</label>
        <input type="password" id="confirm_password" name="confirm_password" required/>
        <div class="actions">
            <button type="submit" class="btn btn-primary">Change password</button>
        </div>
    </form>
{/if}
