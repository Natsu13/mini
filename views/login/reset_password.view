{include "header", ["title" => "Forgot password"]}

{if isset($model["error"])}
    <div class="flash flash-error">{$model["error"]}</div>
{/if}
{if isset($model["success"]) && $model["success"]}
    <div class="flash flash-success">If this email is registered, a password reset link has been sent to it.</div>
{/if}

<form action="{route 'auth.password.reset'}" method="post" class="form">
    {csrf}
    <label for="email">E-mail</label>
    <input type="text" id="email" name="email" required />
    <div class="actions">
        <button type="submit" class="btn btn-primary">Reset password</button>
        <a href="{route 'auth.login'}">Back to sign in</a>
    </div>
</form>