{include "header", ["title" => "Sign in"]}

{if isset($model["state"])}
    {if $model["state"] == UserServiceLogin::WrongLogin}
        <div class="flash flash-error">Wrong login</div>
    {elseif $model["state"] == UserServiceLogin::WrongPassword}
        <div class="flash flash-error">Wrong password</div>
    {elseif $model["state"] == UserServiceLogin::Blocked}
        <div class="flash flash-error">Too many failed attempts. Please try again in {$model["retryMinutes"]} minutes.</div>
    {/if}
{/if}

<form action="{route 'auth.login'}" method="post" class="form">
    {csrf}
    <input type="hidden" name="back" value="{$model['back']}"/>
    <label for="login">Login or e-mail</label>
    <input type="text" id="login" name="login" value="{$model['login'] ?? ''}" autofocus />
    <label for="password">Password</label>
    <input type="password" id="password" name="password" />
    <div class="actions">
        <button type="submit" class="btn btn-primary">Sign in</button>
        <a href="{route 'auth.register'}">Register</a>
        <a href="{route 'auth.password.reset'}">Forgot password?</a>
    </div>
</form>
