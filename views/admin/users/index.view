{include "header", ["title" => "Users"]}

<form method="get" action="{route 'admin.users'}" class="form-inline">
    <input type="text" name="q" value="{$model['q']}" placeholder="Search login or e-mail" />
    <button type="submit" class="btn">Search</button>
    {if $model["q"] !== ""}<a href="{route 'admin.users'}">Clear</a>{/if}
</form>

<table class="table">
    <tr><th>ID</th><th>Login</th><th>E-mail</th><th>Role</th><th></th></tr>
    {for $model["users"] as $user}
        <tr>
            <td>{$user->id}</td>
            <td>{$user->login}</td>
            <td>{$user->email}</td>
            <td>{if $user->getPermission()}{!$user->getPermission()->print()}{else}<i>none</i>{/if}</td>
            <td class="actions">
                <a href="{route 'admin.users.edit', ['id' => $user->id]}">Edit</a>
                {if $user->id !== $model["me"]->id}
                    <form method="post" action="{route 'admin.users.delete', ['id' => $user->id]}" class="inline" onsubmit="return confirm('Delete this user and all their articles?');">
                        {csrf}
                        <button type="submit" class="btn btn-link danger">Delete</button>
                    </form>
                {/if}
            </td>
        </tr>
    {/for}
</table>
{!$model["paginator"]->render()}
