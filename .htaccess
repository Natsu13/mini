RewriteEngine On

# Block hidden files and directories (.git, .env, .htaccess, ...) at any depth, except .well-known (Let's Encrypt etc.)
RewriteRule "(^|/)\.(?!well-known/)" - [R=404,L]

# Block internal directories
RewriteRule "^(temp|emails|errors|views|controllers|models)(/|$)" - [R=404,L]

# Block sensitive files by extension and by name
<FilesMatch "\.(json|env|log|ini)$|^(library\.php|README\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Only index.php may be executed, comment this section out if you want to allow other PHP files to be executed
RewriteRule "^(?!index\.php$).+\.php$" - [R=404,L]

# Serve existing files and directories directly
RewriteCond %{REQUEST_FILENAME} -d [or]
RewriteCond %{REQUEST_FILENAME} -f
RewriteCond %{REQUEST_URI} !^/index\.php$
RewriteRule ^(.*)$ $1 [L,QSA]

# Everything else goes to the front controller
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule (.*) index.php?url=$1 [L]